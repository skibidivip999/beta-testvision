        task.wait(0.2)
        if not Island.Parent then continue end
        local st = IslandState.current
        if st == "loading" or st == "loaded" then continue end
        if not Config.AutoFarm then
            if st ~= "idle" then islandSetIdle() end
        else
            local lvl = getLevel()
            if lvl >= MAX_LEVEL then
                if st ~= "max" then islandSetMax() end
            else
                islandSetFarming(lvl)
            end
        end
    end
