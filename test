    end)
end

RunService.Heartbeat:Connect(function()
    if not Config.FastAttack then return end
    local hum = getHum()
    if hum then
        pcall(function()
            hum:SetAttribute("AttackCooldown", Config.FastAttackSpeed)
            hum:SetAttribute("SwingCooldown", Config.FastAttackSpeed)
        end)
    end
end)

task.spawn(function()
    while task.wait(0.4) do
        if not Config.AutoFarm then continue end
        local char, hum, root = getChar(), getHum(), getRoot()
        if not (hum and root and hum.Health > 0) then continue end
        if Config.BringMob then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Humanoid") and obj.Health > 0 and obj.Parent ~= char then
                    local mroot = obj.Parent and obj.Parent:FindFirstChild("HumanoidRootPart")
                    if mroot then
                        pcall(function()
                            mroot.CFrame = root.CFrame * CFrame.new(0, 0, -3)
                        end)
                    end
                end
            end
        end
    end
end)

