local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function corner(p, r) return new("UICorner", { CornerRadius = UDim.new(0, r) }, p) end
local function stroke(p, c, t) return new("UIStroke", { Color = c or T.Border, Thickness = t or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, p) end

local function getLevel()
    local p = LocalPlayer
    local attr = p:GetAttribute("Level")
    if attr then local n = tonumber(attr); if n then return math.floor(n) end end
    local data = p:FindFirstChild("Data")
    if data then
        local l = data:FindFirstChild("Level")
        if l and l:IsA("ValueBase") then
            local n = tonumber(l.Value); if n then return math.floor(n) end
        end
    end
    local l = p:FindFirstChild("Level")
    if l and l:IsA("ValueBase") then
        local n = tonumber(l.Value); if n then return math.floor(n) end
    end
    return 0
end


