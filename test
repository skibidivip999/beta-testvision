local function startPulse(dot)
    task.spawn(function()
        while dot.Parent do
            local t1 = TweenService:Create(dot, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                BackgroundTransparency = 0.65,
            }); t1:Play(); t1.Completed:Wait()
            if not dot.Parent then break end
            local t2 = TweenService:Create(dot, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                BackgroundTransparency = 0,
            }); t2:Play(); t2.Completed:Wait()
        end
    end)
end

