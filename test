        BackgroundTransparency = 1, Text = label, TextColor3 = T.Text,
        Font = T.Font, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
    }, f)
    local track = new("Frame", {
        Size = UDim2.new(0, 38, 0, 20), Position = UDim2.new(1, -52, 0.5, -10),
        BackgroundColor3 = T.Surface2, BorderSizePixel = 0,
    }, f); corner(track, 10)
    local knob = new("Frame", {
        Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = T.Dim, BorderSizePixel = 0,
    }, track); corner(knob, 8)
    local state = default
    local function apply(anim)
        local ti = TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        local pos = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        local kc  = state and Color3.new(1,1,1) or T.Dim
        local tc  = state and T.Accent or T.Surface2
        if anim then
            TweenService:Create(knob, ti, { Position = pos, BackgroundColor3 = kc }):Play()
            TweenService:Create(track, ti, { BackgroundColor3 = tc }):Play()
        else
            knob.Position = pos; knob.BackgroundColor3 = kc; track.BackgroundColor3 = tc
        end
    end
    apply(false)
    local click = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "",
    }, f)
    click.MouseButton1Click:Connect(function()
        state = not state; apply(true)
        if callback then callback(state) end
    end)
    return f
end

local function slider(parent, label, min, max, default, step, callback)
    local f = new("Frame", { Size = UDim2.new(1, 0, 0, 52), BackgroundTransparency = 1 }, parent)
    new("TextLabel", {
        Size = UDim2.new(1, -80, 0, 20), Position = UDim2.new(0, 4, 0, 0),
        BackgroundTransparency = 1, Text = label, TextColor3 = T.Text,
        Font = T.Font, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
    }, f)
    local valLabel = new("TextLabel", {
        Size = UDim2.new(0, 70, 0, 20), Position = UDim2.new(1, -74, 0, 0),
        BackgroundTransparency = 1, Text = tostring(default),
        TextColor3 = T.Accent, Font = T.FontBold, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, f)
    local track = new("Frame", {
        Size = UDim2.new(1, -8, 0, 6), Position = UDim2.new(0, 4, 0, 30),
        BackgroundColor3 = T.Surface2, BorderSizePixel = 0,
    }, f); corner(track, 3)
    local ratio0 = (default - min) / (max - min)
    local fill = new("Frame", {
        Size = UDim2.new(ratio0, 0, 1, 0), BackgroundColor3 = T.Accent, BorderSizePixel = 0,
    }, track); corner(fill, 3)
    new("UIGradient", { Color = ColorSequence.new(T.Accent, T.Accent2), Rotation = 15 }, fill)
    local knob = new("Frame", {
        Size = UDim2.new(0, 14, 0, 14), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(ratio0, 0, 0.5, 0),
        BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 2,
    }, track); corner(knob, 7)
    local draggingSlider = false
    local function setFromX(ax)
        local ta, tw = track.AbsolutePosition.X, track.AbsoluteSize.X
        local r = math.clamp((ax - ta) / tw, 0, 1)
        local v = min + r * (max - min)
        v = math.floor(v / step + 0.5) * step
        if step < 1 then v = math.floor(v * 100 + 0.5) / 100 else v = math.floor(v + 0.5) end
        fill.Size = UDim2.new(r, 0, 1, 0)
        knob.Position = UDim2.new(r, 0, 0.5, 0)
        valLabel.Text = tostring(v)
        if callback then callback(v) end
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true; setFromX(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if draggingSlider and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setFromX(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)
    return f
end

local function button(parent, label, callback)
    local b = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Color3.new(1,1,1),
        Text = label, TextColor3 = Color3.new(1,1,1),
        Font = T.FontBold, TextSize = 14, AutoButtonColor = false, BorderSizePixel = 0,
    }, parent); corner(b, 8)
    new("UIGradient", { Color = ColorSequence.new(T.Accent, T.Accent2), Rotation = 15 }, b)
    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(180, 160, 255) }):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), { BackgroundColor3 = Color3.new(1,1,1) }):Play()
    end)
    b.MouseButton1Click:Connect(function() if callback then callback() end end)
    return b
end

