    if show then
        hideToken = hideToken + 1
        Main.Visible = true
        UIScale.Scale = 0
        TweenService:Create(UIScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
    else
        hideToken = hideToken + 1
        local myToken = hideToken
        TweenService:Create(UIScale, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), { Scale = 0 }):Play()
