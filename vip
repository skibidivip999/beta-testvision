-- Xử lý nút X để đóng/tắt UI hoàn toàn
CloseBtn.MouseButton1Click:Connect(function()
	MainMenu.Visible = false
	FOVCircle.Visible = false
	AimbotEnabled = false -- Tắt luôn aimbot khi đóng UI cho an toàn
end)

-- Thay đổi màu nút X khi rê chuột qua tạo hiệu ứng mượt mà
