----------------------------------------------------------------
-- Chuyển đổi Pill <-> Card (kéo xuống)
----------------------------------------------------------------

local isExpanded = false
local isAnimating = false
local introPlaying = true -- chặn tương tác trong lúc chạy hiệu ứng welcome

local function expand()
	if isExpanded or isAnimating or introPlaying then
		return
	end
	isAnimating = true
	isExpanded = true

	TweenService:Create(root, EASE_SNAP, { Size = CARD_SIZE, Position = FIXED_POSITION }):Play()
	TweenService:Create(rootCorner, EASE_SNAP, { CornerRadius = UDim.new(0, CARD_CORNER) }):Play()

	TweenService:Create(pillLabel, EASE_FADE, { TextTransparency = 1 }):Play()

	task.delay(0.15, function()
		for _, el in ipairs(cardElements) do
			if el:IsA("TextLabel") then
				TweenService:Create(el, EASE_FADE, { TextTransparency = 0 }):Play()
			else
				TweenService:Create(el, EASE_FADE, { ImageTransparency = 0 }):Play()
			end
		end
		isAnimating = false
	end)
end

local function collapse()
	if not isExpanded or isAnimating or introPlaying then
		return
	end
	isAnimating = true
	isExpanded = false

	for _, el in ipairs(cardElements) do
		if el:IsA("TextLabel") then
			TweenService:Create(el, EASE_FADE, { TextTransparency = 1 }):Play()
		else
			TweenService:Create(el, EASE_FADE, { ImageTransparency = 1 }):Play()
		end
	end

	TweenService:Create(root, EASE_SNAP, { Size = PILL_SIZE, Position = FIXED_POSITION }):Play()
	TweenService:Create(rootCorner, EASE_SNAP, { CornerRadius = UDim.new(0, PILL_CORNER) }):Play()

	task.delay(0.2, function()
		TweenService:Create(pillLabel, EASE_FADE, { TextTransparency = 0 }):Play()
		isAnimating = false
	end)
end

----------------------------------------------------------------
-- Cử chỉ kéo xuống (không cho di chuyển tự do)
----------------------------------------------------------------

local dragging = false
local dragStartY = 0
local dragConnection: RBXScriptConnection? = nil
local dragEndConnection: RBXScriptConnection? = nil

local function onInputBegan(input: InputObject)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	if isAnimating or introPlaying then
		return
	end

	dragging = true
	dragStartY = input.Position.Y

	dragConnection = UserInputService.InputChanged:Connect(function(moveInput)
		if not dragging then
			return
		end
		if moveInput.UserInputType ~= Enum.UserInputType.MouseMovement and moveInput.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local deltaY = moveInput.Position.Y - dragStartY

		if not isExpanded and deltaY > DRAG_THRESHOLD then
			expand()
		elseif isExpanded and deltaY < -DRAG_THRESHOLD then
			collapse()
		end
	end)

	dragEndConnection = UserInputService.InputEnded:Connect(function(endInput)
		if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			if dragConnection then
				dragConnection:Disconnect()
				dragConnection = nil
			end
			if dragEndConnection then
				dragEndConnection:Disconnect()
				dragEndConnection = nil
			end
		end
	end)
end

root.InputBegan:Connect(onInputBegan)

root.MouseButton1Click:Connect(function()
	if isExpanded and not introPlaying then
		collapse()
	end
end)

----------------------------------------------------------------
-- 0. Hiệu ứng WELCOME lúc mở game:
--    tiny -> bung ra chào mừng -> thu lại -> mở ra pill nhiệm vụ bình thường
----------------------------------------------------------------

local function playIntro()
	-- bung ra hiện chữ chào mừng
	TweenService:Create(root, EASE_INTRO, { Size = WELCOME_SIZE }):Play()
	local welcomeIn = TweenService:Create(welcomeLabel, EASE_FADE, { TextTransparency = 0 })
	task.wait(0.2)
	welcomeIn:Play()

	task.wait(1.6) -- giữ chữ welcome trên màn hình một lúc

	-- thu chữ welcome lại
	local welcomeOut = TweenService:Create(welcomeLabel, EASE_FADE, { TextTransparency = 1 })
	welcomeOut:Play()
	TweenService:Create(root, EASE_SNAP, { Size = TINY_SIZE }):Play()
	task.wait(0.35)

	-- mở ra thành pill nhiệm vụ ban đầu
	introPlaying = false
	TweenService:Create(root, EASE_SNAP, { Size = PILL_SIZE }):Play()
	task.wait(0.2)
	TweenService:Create(pillLabel, EASE_FADE, { TextTransparency = 0 }):Play()
	TweenService:Create(statusDot, EASE_FADE, { BackgroundTransparency = 0 }):Play()
	TweenService:Create(avatarImage, EASE_FADE, { ImageTransparency = 0, BackgroundTransparency = 0 }):Play()
	setOnlineStatus(QUEST_DATA.statusOnline)
end

