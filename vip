	Name = "StatusGlow",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 0, 0.5, 0),
	Size = UDim2.fromOffset(10, 10),
	BackgroundColor3 = COLORS.green,
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	ZIndex = 2,
