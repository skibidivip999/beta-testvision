----------------------------------------------------------------

local QUEST_DATA = {
	statusOnline = true, -- true = chấm xanh phát sáng, false = chấm đỏ tĩnh
	pillText = "Killing Dough king to get Mirror",

	itemIconId = "rbxassetid://0", -- thay bằng asset id icon của bạn
	itemTitle = "Mirror Fractal",
	itemDescription = "The Mirror Fractal is a mysterious relic with a shimmering, "
		.. "mirror-like surface that reflects light in strange ways. It is said to "
		.. "resonate with hidden powers and plays a key role in unlocking the truth.",
}

