-- helper tạo avatar + chấm trạng thái (dùng lại được ở nhiều nơi)
local statusRefs: { { dot: Frame, glow: Frame } } = {}

local function createStatusAvatar(parent: Instance, avatarSize: number, dotSize: number, position: UDim2, anchor: Vector2)
	local holder = new("Frame", {
		Size = UDim2.fromOffset(avatarSize + 6, avatarSize + 6),
		Position = position,
		AnchorPoint = anchor,
		BackgroundTransparency = 1,
	})
	holder.Parent = parent

	local avatar = new("ImageLabel", {
		Name = "Avatar",
		Size = UDim2.fromOffset(avatarSize, avatarSize),
		Position = UDim2.fromOffset(0, 0),
		BackgroundColor3 = Color3.fromRGB(40, 40, 42),
		BorderSizePixel = 0,
		Image = "",
	}, { corner(999) })
	avatar.Parent = holder

	task.spawn(function()
		local ok, content = pcall(function()
			return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		if ok and content then
			avatar.Image = content
		end
	end)

	local dot = new("Frame", {
		Name = "StatusDot",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 1, 1, 1),
		Size = UDim2.fromOffset(dotSize, dotSize),
		BackgroundColor3 = COLORS.green,
		BorderSizePixel = 0,
		ZIndex = 3,
	}, {
		corner(999),
		new("UIStroke", { Color = COLORS.bg, Thickness = 2 }),
	})
	dot.Parent = avatar

	local glow = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.fromOffset(dotSize, dotSize),
		BackgroundColor3 = COLORS.green,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
	}, { corner(999) })
	glow.Parent = dot

	table.insert(statusRefs, { dot = dot, glow = glow })
	return holder, avatar, dot, glow
end

local function refreshStatusVisual(online: boolean)
	QUEST_DATA.statusOnline = online
	for _, ref in ipairs(statusRefs) do
		ref.dot.BackgroundColor3 = online and COLORS.green or COLORS.red
		local existing = ref.dot:FindFirstChild("GlowTween")
		if existing then
			(existing :: any):Destroy()
		end
		if online then
			ref.glow.Size = UDim2.fromOffset(ref.dot.Size.X.Offset, ref.dot.Size.Y.Offset)
			ref.glow.BackgroundTransparency = 0.35
			local tw = TweenService:Create(
				ref.glow,
				TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, -1, false),
				{ Size = UDim2.fromOffset(ref.dot.Size.X.Offset * 2.2, ref.dot.Size.Y.Offset * 2.2), BackgroundTransparency = 1 }
			)
			tw:Play()
		else
			ref.glow.BackgroundTransparency = 1
		end
	end
end

