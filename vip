----------------------------------------------------------------

local COLORS = {
	pill = Color3.fromRGB(10, 10, 10),
	pillEdge = Color3.fromRGB(28, 28, 30),
	text = Color3.fromRGB(245, 245, 247),
	dim = Color3.fromRGB(190, 190, 195),
	green = Color3.fromRGB(50, 215, 75),
	red = Color3.fromRGB(255, 69, 58),
}

local PILL_SIZE = UDim2.fromOffset(260, 44)
local CARD_SIZE = UDim2.fromOffset(300, 130)
