local function playGlowLoop()
	statusGlow.Size = UDim2.fromOffset(10, 10)
	statusGlow.BackgroundTransparency = 0.35
	local tw = TweenService:Create(
		statusGlow,
		TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, -1, false),
		{ Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1 }
	)
	tw:Play()
	return tw
end

local activeGlowTween: Tween? = nil

local function setOnlineStatus(online: boolean)
	QUEST_DATA.statusOnline = online
	statusDot.BackgroundColor3 = online and COLORS.green or COLORS.red
	statusGlow.BackgroundColor3 = COLORS.green

	if activeGlowTween then
		activeGlowTween:Cancel()
		activeGlowTween = nil
	end

	if online then
		activeGlowTween = playGlowLoop()
	else
		statusGlow.BackgroundTransparency = 1
	end
end

