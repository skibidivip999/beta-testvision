-- Auto Farm NPC
local autoFarmRunning = false
local farmConnection = nil
local function toggleAutoFarm(state)
    autoFarmRunning = state
    if farmConnection then farmConnection:Disconnect() farmConnection = nil end
    if state then
        farmConnection = runService.Heartbeat:Connect(function()
            if not character or not root then return end
            local nearest = nil
            local dist = math.huge
            for _, v in pairs(workspace:GetChildren()) do
                if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
                    if v.Name ~= player.Name and v:FindFirstChild("Humanoid").Health > 0 then
                        local mag = (root.Position - v.HumanoidRootPart.Position).Magnitude
                        if mag < dist and mag < 100 then
                            dist = mag
                            nearest = v
                        end
                    end
                end
            end
            if nearest then
                root.CFrame = nearest.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
                virtualInput:SendKeyEvent(true, "Q", false, nil)
                task.wait(0.3)
                virtualInput:SendKeyEvent(false, "Q", false, nil)
            end
        end)
    end
end

-- ESP
local espObjects = {}
local espRunning = false
local function toggleESP(state)
    espRunning = state
    if not state then
        for _, v in pairs(espObjects) do v:Destroy() end
        espObjects = {}
        return
    end
    espObjects = {}
    for _, v in pairs(workspace:GetChildren()) do
