-- Vị trí tab lớn
local tabButtons = {}
local contentFrames = {}

-- Tạo các tab lớn
for i, tabData in ipairs(mainTabs) do
    local btn = Instance.new("TextButton")
    btn.Parent = mainFrame
    btn.Size = UDim2.new(0, 110, 0, 30)
    btn.Position = UDim2.new(0, 10 + ((i-1) * 115), 0, 5)
    btn.BackgroundColor3 = Color3.new(0.15, 0.15, 0.15)
    btn.BorderSizePixel = 0
    applyCorners(btn, 6)
    btn.Text = tabData.name
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    table.insert(tabButtons, btn)

    -- Frame chứa nội dung của tab lớn (ScrollingFrame)
    local content = Instance.new("ScrollingFrame")
    content.Parent = mainFrame
    content.Size = UDim2.new(1, -20, 0, 490)
    content.Position = UDim2.new(0, 10, 0, 45)
    content.BackgroundColor3 = Color3.new(0.05, 0.05, 0.05)
    content.BorderSizePixel = 0
    applyCorners(content, 8)
    content.Visible = false
    content.CanvasSize = UDim2.new(0, 0, 0, 0)
    content.ScrollBarThickness = 6
    table.insert(contentFrames, content)

    -- Tạo sub-tab bên trong
    local subTabY = 5
    for _, subData in ipairs(tabData.subTabs) do
        -- Tạo khung sub-tab (có thể là một TextLabel hoặc Frame)
        local subFrame = Instance.new("Frame")
        subFrame.Parent = content
        subFrame.Size = UDim2.new(1, -20, 0, 30)
        subFrame.Position = UDim2.new(0, 10, 0, subTabY)
        subFrame.BackgroundColor3 = Color3.new(0.1, 0.1, 0.1)
        subFrame.BorderSizePixel = 0
        applyCorners(subFrame, 6)

        local subLabel = Instance.new("TextLabel")
        subLabel.Parent = subFrame
        subLabel.Size = UDim2.new(1, 0, 1, 0)
        subLabel.BackgroundTransparency = 1
        subLabel.Text = subData.name
        subLabel.TextColor3 = Color3.new(0.8, 0.8, 0.8)
        subLabel.TextXAlignment = Enum.TextXAlignment.Left
        subLabel.Font = Enum.Font.GothamBold
        subLabel.TextSize = 14

        subTabY = subTabY + 35

        -- Tạo các toggle/button cho sub-tab này
        local toggleY = subTabY
        for _, toggleData in ipairs(subData.toggles) do
            createToggle(content, toggleData.label, 20, toggleY, false, toggleData.func)
            toggleY = toggleY + 35
        end
        -- Cập nhật subTabY để sub-tab tiếp theo không bị đè
        subTabY = toggleY + 5
    end

    -- Cập nhật CanvasSize
    content.CanvasSize = UDim2.new(0, 0, 0, subTabY + 20)

    -- Sự kiện click tab
    btn.MouseButton1Click:Connect(function()
        for j, b in ipairs(tabButtons) do
            contentFrames[j].Visible = false
            b.BackgroundColor3 = Color3.new(0.15, 0.15, 0.15)
        end
        content.Visible = true
        btn.BackgroundColor3 = Color3.new(0.4, 0.4, 0.4)
    end)
end

