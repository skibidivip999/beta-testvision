-- Âm thanh: chỉ phát được asset đã tải lên Roblox, KHÔNG stream thẳng
-- từ YouTube (Roblox không hỗ trợ URL ngoài cho SoundId).
----------------------------------------------------------------

local nowPlayingSound = new("Sound", { Name = "NowPlayingSound", Volume = 0.5 })
nowPlayingSound.Parent = root

local function playFromYoutubeLink(link: string)
	local trimmed = link:gsub("^%s+", ""):gsub("%s+$", "")
	if trimmed == "" then
		return
	end

	local assetId = YOUTUBE_TO_ASSET[trimmed]
	if not assetId then
		-- Chưa có asset tương ứng: báo cho người chơi biết, KHÔNG cố tải
		-- trực tiếp từ YouTube vì Roblox không hỗ trợ và vi phạm bản quyền.
		nowPlayingLabel.Text = "Chưa có bài hát này (cần thêm asset id)"
		return
	end

	nowPlayingSound.SoundId = assetId
	nowPlayingSound:Play()
	nowPlayingLabel.Text = "Đang phát..."
	playPauseButton.Text = "⏸"
end

playLinkButton.MouseButton1Click:Connect(function()
	playFromYoutubeLink(linkInput.Text)
end)

linkInput.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		playFromYoutubeLink(linkInput.Text)
	end
end)

playPauseButton.MouseButton1Click:Connect(function()
	if nowPlayingSound.SoundId == "" then
		return
	end
	if nowPlayingSound.IsPlaying then
		nowPlayingSound:Pause()
		playPauseButton.Text = "▶"
	else
		nowPlayingSound:Resume()
		playPauseButton.Text = "⏸"
	end
end)

----------------------------------------------------------------
-- Chuyển trạng thái (idle <-> player) qua Visible, KHÔNG dựa transparency
----------------------------------------------------------------

local isExpanded = false
local isAnimating = false
local introPlaying = true

local function showLayer(target: Frame)
	welcomeLayer.Visible = (target == welcomeLayer)
	pillLayer.Visible = (target == pillLayer)
	playerLayer.Visible = (target == playerLayer)
end

local function expand()
	if isExpanded or isAnimating or introPlaying then
		return
	end
	isAnimating = true
	isExpanded = true

	TweenService:Create(root, EASE_SNAP, { Size = PLAYER_SIZE, Position = FIXED_POSITION }):Play()
	TweenService:Create(rootCorner, EASE_CORNER, { CornerRadius = UDim.new(0, PLAYER_CORNER) }):Play()

	task.delay(0.2, function()
		showLayer(playerLayer)
		isAnimating = false
	end)
end

local function collapse()
	if not isExpanded or isAnimating or introPlaying then
		return
	end
	isAnimating = true
	isExpanded = false

	showLayer(pillLayer)

	TweenService:Create(root, EASE_SNAP, { Size = PILL_SIZE, Position = FIXED_POSITION }):Play()
	TweenService:Create(rootCorner, EASE_CORNER, { CornerRadius = UDim.new(0, PILL_CORNER) }):Play()

	task.delay(0.3, function()
		isAnimating = false
	end)
end

----------------------------------------------------------------
-- Cử chỉ kéo xuống (pill cố định vị trí, chỉ quyết định bung/thu)
----------------------------------------------------------------

local dragging = false
local dragStartY = 0
local dragConnection: RBXScriptConnection? = nil
local dragEndConnection: RBXScriptConnection? = nil

root.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	-- không bắt kéo khi đang thao tác trong ô nhập link
	if linkInput:IsFocused() then
		return
	end
	if isAnimating or introPlaying then
		return
	end

	dragging = true
	dragStartY = input.Position.Y

	dragConnection = UserInputService.InputChanged:Connect(function(moveInput)
		if not dragging then
			return
		end
		if moveInput.UserInputType ~= Enum.UserInputType.MouseMovement and moveInput.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local deltaY = moveInput.Position.Y - dragStartY

		if not isExpanded and deltaY > DRAG_THRESHOLD then
			expand()
		elseif isExpanded and deltaY < -DRAG_THRESHOLD then
			collapse()
		end
	end)

	dragEndConnection = UserInputService.InputEnded:Connect(function(endInput)
		if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			if dragConnection then
				dragConnection:Disconnect()
				dragConnection = nil
			end
			if dragEndConnection then
				dragEndConnection:Disconnect()
				dragEndConnection = nil
			end
		end
	end)
end)

----------------------------------------------------------------
-- 0. Hiệu ứng welcome lúc vào game — 2. đảm bảo chữ LUÔN hiện đúng
----------------------------------------------------------------

local function playIntro()
	showLayer(welcomeLayer)
	TweenService:Create(root, EASE_INTRO, { Size = WELCOME_SIZE }):Play()
	task.wait(1.8)

	TweenService:Create(root, EASE_SNAP, { Size = TINY_SIZE }):Play()
	task.wait(0.35)

	introPlaying = false
	showLayer(pillLayer)
	refreshStatusVisual(QUEST_DATA.statusOnline)
	TweenService:Create(root, EASE_SNAP, { Size = PILL_SIZE }):Play()
	TweenService:Create(rootCorner, EASE_CORNER, { CornerRadius = UDim.new(0, PILL_CORNER) }):Play()
end

