-- ===== TẠO UI =====

local tabNames = {"Main", "Shop", "Performance", "Misc", "BuffSection", "Fruits Collection"}
local tabButtons = {}
local contents = {}

for i, name in ipairs(tabNames) do
    local btn = Instance.new("TextButton")
    btn.Parent = mainFrame
    btn.Size = UDim2.new(0, 95, 0, 30)
    btn.Position = UDim2.new(0, 10 + ((i-1) * 100), 0, 5)
    btn.BackgroundColor3 = Color3.new(0.15, 0.15, 0.15)
    btn.BorderSizePixel = 0
    applyCorners(btn, 6)
    btn.Text = name
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    table.insert(tabButtons, btn)

    local content = Instance.new("ScrollingFrame")
    content.Parent = mainFrame
    content.Size = UDim2.new(1, -20, 0, 440)
    content.Position = UDim2.new(0, 10, 0, 45)
    content.BackgroundColor3 = Color3.new(0.05, 0.05, 0.05)
    content.BorderSizePixel = 0
    applyCorners(content, 8)
    content.Visible = false
    content.CanvasSize = UDim2.new(0, 0, 0, 0)
    content.ScrollBarThickness = 6
    table.insert(contents, content)

    -- Nội dung từng tab
    if name == "Main" then
        createSubTab(content, "Main", 5)
        createToggle(content, "Auto Farm", 20, 45, false, toggleAutoFarm)
        createToggle(content, "Auto Boss", 20, 80, false, function(s) print("Auto Boss:", s) end)
        
    elseif name == "Shop" then
        createSubTab(content, "Shop", 5)
        createToggle(content, "Auto Buy", 20, 45, false, function(s) print("Auto Buy:", s) end)
        createToggle(content, "Auto Sell", 20, 80, false, function(s) print("Auto Sell:", s) end)
        
    elseif name == "Performance" then
        createSubTab(content, "Performance", 5)
        createToggle(content, "Low Graphics", 20, 45, false, function(s) 
            game:GetService("Workspace").GlobalShadows = not s
            game:GetService("Workspace").QualityLevel = s and 1 or 4
        end)
        createToggle(content, "High FPS", 20, 80, false, function(s) 
            game:GetService("Workspace").StreamingEnabled = s
        end)
        
    elseif name == "Misc" then
        createSubTab(content, "Misc", 5)
        createToggle(content, "ESP", 20, 45, false, toggleESP)
        createToggle(content, "Speed Hack", 20, 80, false, toggleSpeed)
        createToggle(content, "Fly", 20, 115, false, toggleFly)
        
    elseif name == "BuffSection" then
        createSubTab(content, "BuffSection", 5)
        createToggle(content, "Damage Buff", 20, 45, false, function(s) print("Damage Buff:", s) end)
        createToggle(content, "Defense Buff", 20, 80, false, function(s) print("Defense Buff:", s) end)
        
    elseif name == "Fruits Collection" then
        createSubTab(content, "SelectFruits", 5)
        createSubTab(content, "All", 40)
        createSubTab(content, "AutoHarvest", 75)
        createSubTab(content, "AutoHarvestfruitselectedingarden", 110)
        createToggle(content, "CollectHighValuetoLowValueFruit", 20, 145, false, function(s) print("Collect High to Low:", s) end)
        createSubTab(content, "AutoHarvestAll", 180)
        createSubTab(content, "AutoHarvestall fruitsingarden", 215)
        createSubTab(content, "Night*****", 250)
        createToggle(content, "StopHarvestIfInventoryFull", 20, 285, false, toggleStopHarvest)
        createToggle(content, "Auto Harvest", 20, 320, false, toggleHarvest)
    end

    btn.MouseButton1Click:Connect(function()
        for j, b in ipairs(tabButtons) do
            contents[j].Visible = false
            b.BackgroundColor3 = Color3.new(0.15, 0.15, 0.15)
        end
        content.Visible = true
        btn.BackgroundColor3 = Color3.new(0.4, 0.4, 0.4)
    end)
end

