----------------------------------------------------------------
-- Helper
----------------------------------------------------------------

local function new(className: string, props: { [string]: any }, children: { Instance }?)
	local inst = Instance.new(className)
	for prop, value in pairs(props) do
		(inst :: any)[prop] = value
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	return inst
end

