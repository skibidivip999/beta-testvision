local DRAG_THRESHOLD = 45 -- kéo xuống quá 45px thì bung thẻ
local EASE_SNAP = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local EASE_FADE = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

----------------------------------------------------------------
-- Helper
----------------------------------------------------------------

local function new(className: string, props: { [string]: any }, children: { Instance }?)
	local inst = Instance.new(className)
	for prop, value in pairs(props) do
		(inst :: any)[prop] = value
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	return inst
end

local function corner(radius: number)
	return new("UICorner", { CornerRadius = UDim.new(0, radius) })
end

