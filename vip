-- Kéo thả GUI
local dragging = false
local dragStartPos, dragStartMouse

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStartPos = mainFrame.Position
        dragStartMouse = Vector2.new(mouse.X, mouse.Y)
    end
end)

mainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

runService.RenderStepped:Connect(function()
    if dragging then
        local delta = Vector2.new(mouse.X, mouse.Y) - dragStartMouse
        mainFrame.Position = UDim2.new(
            dragStartPos.X.Scale,
            dragStartPos.X.Offset + delta.X,
            dragStartPos.Y.Scale,
            dragStartPos.Y.Offset + delta.Y
        )
    end
end)

-- Lưu trạng thái toggle
local toggleStates = {}

-- Tạo toggle có chức năng
local function createToggle(parent, label, xPos, yPos, defaultState, func)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.Size = UDim2.new(0, 200, 0, 30)
    frame.Position = UDim2.new(0, xPos, 0, yPos)
    frame.BackgroundTransparency = 1

    local labelObj = Instance.new("TextLabel")
    labelObj.Parent = frame
    labelObj.Size = UDim2.new(0.6, 0, 1, 0)
    labelObj.BackgroundTransparency = 1
    labelObj.Text = label
    labelObj.TextColor3 = Color3.new(1, 1, 1)
    labelObj.TextXAlignment = Enum.TextXAlignment.Left
    labelObj.Font = Enum.Font.Gotham
    labelObj.TextSize = 13

    local btn = Instance.new("ImageButton")
    btn.Parent = frame
    btn.Size = UDim2.new(0, 50, 0, 25)
    btn.Position = UDim2.new(0.7, 0, 0, 2)
    btn.BackgroundColor3 = defaultState and Color3.new(0, 0.8, 0) or Color3.new(0.3, 0.3, 0.3)
    btn.BorderSizePixel = 0
    applyCorners(btn, 12)
    btn.Image = "rbxassetid://6031091078"
    btn.ImageColor3 = Color3.new(1, 1, 1)

    local state = defaultState or false
    toggleStates[label] = state

    btn.MouseButton1Click:Connect(function()
        state = not state
        toggleStates[label] = state
        btn.BackgroundColor3 = state and Color3.new(0, 0.8, 0) or Color3.new(0.3, 0.3, 0.3)
        if func then
            func(state)
        end
    end)

    return {btn = btn, state = state, setState = function(newState)
        state = newState
        toggleStates[label] = state
        btn.BackgroundColor3 = state and Color3.new(0, 0.8, 0) or Color3.new(0.3, 0.3, 0.3)
        if func then func(state) end
    end}
end

-- Tạo sub tab (khung con)
local function createSubTab(parentTab, label, yPos)
    local subFrame = Instance.new("Frame")
    subFrame.Parent = parentTab
    subFrame.Size = UDim2.new(1, -20, 0, 30)
    subFrame.Position = UDim2.new(0, 10, 0, yPos)
    subFrame.BackgroundColor3 = Color3.new(0.1, 0.1, 0.1)
    subFrame.BorderSizePixel = 0
    applyCorners(subFrame, 6)

    local subLabel = Instance.new("TextLabel")
    subLabel.Parent = subFrame
    subLabel.Size = UDim2.new(1, 0, 1, 0)
    subLabel.BackgroundTransparency = 1
    subLabel.Text = label
    subLabel.TextColor3 = Color3.new(0.8, 0.8, 0.8)
    subLabel.TextXAlignment = Enum.TextXAlignment.Left
    subLabel.Font = Enum.Font.GothamBold
    subLabel.TextSize = 14

    return subFrame
end

