-- =============================================
-- BYPASS ANTI-CHEAT CORE
-- =============================================
local function BypassAntiCheat()
    if not Config.AntiCheatBypass then return end
    
    -- Vô hiệu hóa các hàm kiểm tra của Byfron/Hyperion
    local mt = getrawmetatable and getrawmetatable(game) or nil
    if mt then
        local old_namecall = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local args = {...}
            local method = getnamecallmethod()
            
            -- Chặn các hàm gửi log về server
            if method == "FireServer" and self and self.Name then
                if self.Name:find("Report") or self.Name:find("Log") or self.Name:find("Detection") or 
                   self.Name:find("AntiCheat") or self.Name:find("Security") or self.Name:find("Ban") then
                    return nil
                end
            end
            
            -- Bypass kiểm tra memory
            if method == "InvokeServer" and self and self.Name:find("Security") then
                return nil
            end
            
            return old_namecall(self, unpack(args))
        end)
        setreadonly(mt, true)
    end
    
    -- Vô hiệu hóa các sự kiện kiểm tra
    local old_connect = Instance.connect
    Instance.connect = function(self, event, func)
        if event and (event == "OnSecurityCheck" or event == "OnDetection" or event == "OnBan" or event == "OnReport") then
            return nil
        end
        return old_connect(self, event, func)
    end
    
    -- Xóa các RemoteEvent kiểm tra
    for _, v in pairs(game:GetDescendants()) do
        if v:IsA("RemoteEvent") and v.Name then
            if v.Name:find("Security") or v.Name:find("AntiCheat") or v.Name:find("Detection") or 
               v.Name:find("Report") or v.Name:find("Ban") or v.Name:find("Log") then
                pcall(function() v:Destroy() end)
            end
        end
    end
    
    print("[Bypass] Anti-Cheat đã được vô hiệu hóa")
end

